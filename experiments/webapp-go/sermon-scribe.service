[Unit]
Description=Sermon Scribe Web App
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/sermon-scribe/experiments/webapp-go
EnvironmentFile=/home/exedev/sermon-scribe/experiments/webapp-go/.env
ExecStart=/home/exedev/sermon-scribe/experiments/webapp-go/sermon-scribe
Restart=always

[Install]
WantedBy=multi-user.target
