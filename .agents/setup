#!/usr/bin/env bash
set -euo pipefail

go_version="$(awk '$1 == "go" { print $2; exit }' go.mod)"
elm_version="$(sed -n 's/.*"elm-version": "\([^"]*\)".*/\1/p' web/elm.json)"
just_version="1.40.0"

if (( EUID == 0 )); then
  sudo=()
else
  sudo=(sudo)
fi

missing_packages=()
command -v curl >/dev/null || missing_packages+=(curl)
command -v ffmpeg >/dev/null || missing_packages+=(ffmpeg)

if (( ${#missing_packages[@]} )); then
  echo "Installing system packages: ${missing_packages[*]}"
  "${sudo[@]}" apt-get update
  "${sudo[@]}" apt-get install -y ca-certificates "${missing_packages[@]}"
fi

if ! command -v go >/dev/null || [[ "$(go env GOVERSION 2>/dev/null || true)" != "go${go_version}" ]]; then
  echo "Installing Go ${go_version}"
  curl -fsSL "https://go.dev/dl/go${go_version}.linux-amd64.tar.gz" -o /tmp/go.tar.gz
  "${sudo[@]}" rm -rf /usr/local/go
  "${sudo[@]}" tar -C /usr/local -xzf /tmp/go.tar.gz
  "${sudo[@]}" ln -sf /usr/local/go/bin/go /usr/local/bin/go
  "${sudo[@]}" ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
  rm /tmp/go.tar.gz
fi

if ! command -v elm >/dev/null || [[ "$(elm --version 2>/dev/null || true)" != "${elm_version}" ]]; then
  echo "Installing Elm ${elm_version}"
  curl -fsSL "https://github.com/elm/compiler/releases/download/${elm_version}/elm-${elm_version}-linux-x64.gz" -o /tmp/elm.gz
  gunzip -f /tmp/elm.gz
  chmod +x /tmp/elm
  "${sudo[@]}" install /tmp/elm /usr/local/bin/elm
  rm /tmp/elm
fi

if ! command -v just >/dev/null; then
  echo "Installing just ${just_version}"
  curl -fsSL "https://github.com/casey/just/releases/download/${just_version}/just-${just_version}-x86_64-unknown-linux-musl.tar.gz" -o /tmp/just.tar.gz
  tar -xzf /tmp/just.tar.gz -C /tmp just
  "${sudo[@]}" install /tmp/just /usr/local/bin/just
  rm /tmp/just /tmp/just.tar.gz
fi

echo "Downloading project dependencies"
go mod download
(cd web && elm make src/Main.elm --output=/dev/null)

echo "Development environment is ready. Run 'just run' to start the app on http://localhost:8000."
